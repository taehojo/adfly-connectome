    given-names: Taeho
    orcid: "https://orcid.org/0000-0003-1765-5735"
    affiliation: "Indiana University School of Medicine, Indianapolis, Indiana, United States of America"
    email: tjo@iu.edu
version: "1.0.0"
date-released: "2026-10-10"
repository-code: "https://github.com/taehojo/adfly-connectome"
# The licence field is that of the code. A list here would mean a choice between licences, which is
# not the case: the data files have their own terms, given in the abstract and in LICENSE-DATA.md.
license: MIT
keywords:
  - connectome
  - Drosophila
  - "Alzheimer's disease"
  - amyloid
  - "leaky integrate-and-fire"
  - "whole-brain simulation"
  - MaleCNS
